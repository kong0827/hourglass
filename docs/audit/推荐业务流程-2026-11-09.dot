digraph TargetFlow {
  graph [rankdir=TB, bgcolor="#FFFFFF", pad="0.3", nodesep="0.45", ranksep="0.6", fontname="PingFang SC", fontsize=20, label="已实施业务流程\n生产已部署 124ce05 · 原库授权重建 · 完整生产模拟完成\n生产只读验收通过 · 生产浏览器验收通过\n计划范围 ≠ 实际范围 · 完成 ≠ 发布 · 徽标由事实计算\n不引入迭代 · 不迁移历史 · 历史保存在受限备份", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#D0D5DD", fontcolor="#101828", fontname="PingFang SC", fontsize=14, margin="0.65,0.18"];
  edge [color="#98A2B3", fontname="PingFang SC", fontsize=11, fontcolor="#475467", arrowsize=0.7];
  collect [label="需求池提出需求\n业务目标 / 验收标准"];
  review [shape=diamond, label="评审通过？", fillcolor="#FFFAEB", color="#FEDF89"];
  rejected [label="拒绝 / 补充重评"];
  task_plan [label="拆成任务并安排目标版本\n执行人 / 工作内容 / 日期"];
  version_plan [label="项目维护版本\n内容规划 / 就绪目标", fillcolor="#EFF4FF"];
  execute_work [label="任务执行 / 测试 / 完成\n不受计划草稿或取消状态控制\n完成不生成发布徽标"];
  release_plan [label="新建发布计划\n目标版本 / 环境 / 计划时间\n明确选择本次任务范围", fillcolor="#EFF4FF"];
  gate [shape=diamond, label="发布前预览\n范围 / 测试 / 产物\n权限 / 修订号", fillcolor="#FFFAEB", color="#FEDF89"];
  external [label="外部实际部署\n本系统记录事实，不假装执行CI/CD", fillcolor="#F2F4F7"];
  actual [label="记录本次实际结果\n真实时间 / 环境 / 产物 / 范围\n执行人 / 记录人 / 幂等键", fillcolor="#EFF4FF"];
  result [shape=diamond, label="实际结果？"];
  failed [label="失败 / 中止\n保留尝试快照与原因\n不生成已发布徽标", fillcolor="#FEF3F2", color="#FDA29B"];
  retry [label="真实重试：创建新事件\n引用原失败，不覆盖旧事实"];
  succeeded [label="成功记录与实际任务快照\n只记录真正交付的范围\n计划偏离有说明", fillcolor="#ECFDF3", color="#A6F4C5"];
  environment [shape=diamond, label="生产环境成功？"];
  nonproduction [label="测试 / 预发布历史\n不算生产已发布"];
  published [shape=folder, label="已发布历史视图\n成功生产事件 + 实际内容\n灰度明确范围，非自动全量", fillcolor="#ECFDF3", color="#A6F4C5"];
  badge [label="自动计算任务徽标\n有效 / 部分范围 / 已回滚 / 范围未知\n不改任务状态或完成日期", fillcolor="#ECFDF3", color="#A6F4C5"];
  rollback [label="回滚：追加实际事件\n恢复版本 / 产物 / 目标范围\n成功后重算有效状态，原历史保留"];
  collect -> review;
  review -> rejected [label="否"];
  rejected -> collect [label="补充", style=dashed];
  review -> task_plan [label="是"];
  version_plan -> task_plan [label="规划关联", style=dashed];
  task_plan -> execute_work;
  version_plan -> release_plan [label="同版本可多次计划"];
  task_plan -> release_plan [label="可提前规划", style=dashed, constraint=false];
  execute_work -> gate [label="执行 / 测试证据"];
  release_plan -> gate [label="计划范围"];
  gate -> release_plan [label="修订", style=dashed];
  gate -> external [label="常规审批与预检通过"];
  external -> actual [label="已发生事实；异常需说明"];
  actual -> result [label="事务保存记录及快照"];
  result -> failed [label="失败 / 中止"];
  failed -> retry [label="决定再次执行"];
  retry -> external [label="新事件ID", style=dashed, constraint=false];
  result -> succeeded [label="成功"];
  succeeded -> environment;
  environment -> nonproduction [label="否"];
  environment -> published [label="是"];
  published -> badge [label="只读投影"];
  published -> rollback [label="需恢复时", style=dashed];
  rollback -> external [label="新事件，不撤销徽标字段", style=dashed, constraint=false];
}
