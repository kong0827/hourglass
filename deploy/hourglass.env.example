# 沙漏 Hourglass 环境变量模板
# 用法：复制为服务器的 /etc/hourglass.env，按需修改后 chmod 600 /etc/hourglass.env
# 注意：注释必须单独成行，不要写在值后面（行尾的 # 及其后内容会算进变量值）；
#       值里含 $、空格等特殊字符时用单引号包裹，引号会被 systemd 剥掉。

# ---- 数据库（密码必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hourglass
DB_USER=hourglass
# 填 sql/baseline/01_schema_full.sql 执行结束时「沙漏部署提示」打印的一次性密码（脚本不再内置固定口令）
DB_PASSWORD='填写数据库密码'

# ---- 首个管理员（仅库里还没有用户时用于引导创建）----
AUTH_USER=admin
AUTH_PASSWORD='填写管理员登录密码'

# ---- 服务监听（默认只绑本机，对外统一走 nginx）----
SERVER_PORT=8080
BIND_ADDR=127.0.0.1

# ---- 附件目录（相对工作目录或绝对路径）----
# ATTACH_DIR=./data/attachments

# ---- 应用日志（可选）----
# 默认写在工作目录的 logs/hourglass.log；相对路径按工作目录解析，生产即 /opt/hourglass/logs
# LOG_FILE=logs/hourglass.log

# ---- AI Key / SMTP 密码加密密钥（生产必填；更换后需重填已保存的凭据）----
# 可用 openssl rand -base64 48 生成；部署校验会拒绝空值、占位值和公开默认密钥
# AI_CRYPTO_KEY='改成随机长字符串'
# 允许自定义 AI 地址访问内网/回环（本地 Ollama 预设已自动放行；局域网中转才需要）
# AI_ALLOW_PRIVATE_NETWORK=true

# ---- 通知邮件（SMTP 主机与账号由管理员在「系统设置」保存，这里只配站点地址）----
# 站点根地址，含 context-path，用于邮件里的任务/登录链接；留空则邮件不附链接
# MAIL_BASE_URL=https://your-domain/hourglass/
# 站内通知保留天数（默认 90，每天 03:20 清理超期记录）
# NOTIFICATION_RETAIN_DAYS=90

# ---- 提醒推送（webhook 按空间在页面配置，这里只配渠道与开关）----
# NOTIFY_TYPE=webhook
# NOTIFY_ENABLED=false
# NOTIFY_TOKEN=
# NOTIFY_CRON='0 0 9 * * *'
# NOTIFY_LINK=
