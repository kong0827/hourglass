# 沙漏 Hourglass 环境变量模板
# 用法：复制为服务器的 /etc/hourglass.env，按需修改后 chmod 600 /etc/hourglass.env
# 注意：注释必须单独成行，不要写在值后面（行尾的 # 及其后内容会算进变量值）；
#       值里含 $、空格等特殊字符时用单引号包裹，引号会被 systemd 剥掉。

# ---- 数据库（密码必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hourglass
DB_USER=hourglass
# 与 deploy/init/01_schema_full.sql 中创建账号的密码一致（脚本默认是占位密码，上线前替换）
DB_PASSWORD='填写数据库密码'

# ---- 首个管理员（仅库里还没有用户时用于引导创建）----
AUTH_USER=admin
AUTH_PASSWORD='填写管理员登录密码'

# ---- 服务监听（默认只绑本机，对外统一走 nginx）----
SERVER_PORT=8080
BIND_ADDR=127.0.0.1

# ---- 附件目录（相对工作目录或绝对路径）----
# ATTACH_DIR=./data/attachments

# ---- AI Key 加密密钥（生产务必更换；更换后用户需在个人设置里重填 key）----
# AI_CRYPTO_KEY='改成随机长字符串'

# ---- 提醒推送（webhook 按空间在页面配置，这里只配渠道与开关）----
# NOTIFY_TYPE=webhook
# NOTIFY_ENABLED=false
# NOTIFY_TOKEN=
# NOTIFY_CRON='0 0 9 * * *'
# NOTIFY_LINK=
